# nexbridge · variables de entorno (copiar a .env)
# Las credenciales NO van aquí: van en ./secrets/ (local) o en un Secret (AKS).

# --- Destino OnPrem ----------------------------------------------------------
TUNNEL_REMOTE_HOST=x.x.x.x
TUNNEL_REMOTE_USER=aks-nemesis
TUNNEL_REMOTE_PORT=443

# --- Reenvíos (-L), separados por espacio: [bind:]puerto_local:host_remoto:puerto_remoto
TUNNEL_FORWARDS=0.0.0.0:3000:127.0.0.1:3000

# --- Comportamiento ----------------------------------------------------------
TUNNEL_ENABLED=true
SSHD_ENABLED=true            # sandbox sshd heredado (puerto 2222 en host)
TUNNEL_VERBOSITY=3           # 0..3  (3 = -vvv)
# TUNNEL_SERVER_ALIVE_INTERVAL=30
# TUNNEL_SERVER_ALIVE_COUNT_MAX=3
# TUNNEL_CONNECT_TIMEOUT=15
# TUNNEL_BACKOFF_MIN=2
# TUNNEL_BACKOFF_MAX=60
# TUNNEL_MAX_RETRIES=        # vacío = infinito
# TUNNEL_HEALTH_PATH=/v1/models
# TUNNEL_KEY_FILE_NAME=id_rsa_ed25519

# --- Sandbox -----------------------------------------------------------------
# SANDBOX_TESTER_PASSWORD=tester123
# SANDBOX_ROOT_PASSWORD=root123
